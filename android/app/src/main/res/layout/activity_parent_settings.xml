<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0708"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="36dp"
        android:paddingBottom="40dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <Button
                android:id="@+id/btnBackFromSettings"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="#262222"
                android:text="← Quay lại"
                android:textColor="#E5E7EB"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Cài Đặt Phụ Huynh"
                android:textColor="#FEF3C7"
                android:textSize="18sp"
                android:textStyle="bold"
                android:gravity="center" />

            <View
                android:layout_width="40dp"
                android:layout_height="1dp" />
        </LinearLayout>

        <!-- PIN Gate Container (shown initially) -->
        <LinearLayout
            android:id="@+id/layoutPinGate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#1E1919"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔒 Xác Thực Quyền Phụ Huynh"
                android:textColor="#FBBF24"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Nhập mã PIN 4 số (Mặc định: 1225 - Đêm Noel):"
                android:textColor="#9CA3AF"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etPinCode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="#2E2828"
                android:inputType="numberPassword"
                android:maxLength="4"
                android:textColor="#FFFFFF"
                android:textColorHint="#6B7280"
                android:hint="Nhập 1225"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <Button
                android:id="@+id/btnVerifyPin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:backgroundTint="#059669"
                android:text="Mở Khóa Bảng Điều Khiển"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Profile Form Container (hidden until unlocked) -->
        <LinearLayout
            android:id="@+id/layoutProfileForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Child Name -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tên của bé:"
                android:textColor="#FEF3C7"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/etChildName"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#1E1919"
                android:textColor="#FFFFFF"
                android:hint="Ví dụ: Bé Bo, Nam, Linh"
                android:textColorHint="#6B7280"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginTop="4dp" />

            <!-- Child Age -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tuổi của bé:"
                android:textColor="#FEF3C7"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/etChildAge"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#1E1919"
                android:inputType="number"
                android:textColor="#FFFFFF"
                android:hint="Ví dụ: 5"
                android:textColorHint="#6B7280"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginTop="4dp" />

            <!-- Dream Gift -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Món quà bé đang mong ước nhất:"
                android:textColor="#FEF3C7"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <EditText
                android:id="@+id/etChildGift"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#1E1919"
                android:textColor="#FFFFFF"
                android:hint="Ví dụ: Bộ xếp hình cỗ xe tuần lộc Lego"
                android:textColorHint="#6B7280"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginTop="4dp" />

            <!-- Language Switch -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ngôn ngữ Santa trò chuyện:"
                android:textColor="#FEF3C7"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginTop="6dp">

                <Button
                    android:id="@+id/btnLangVi"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#059669"
                    android:text="🇻🇳 Tiếng Việt"
                    android:textColor="#FFFFFF"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btnLangEn"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:backgroundTint="#262222"
                    android:text="🇺🇸 English"
                    android:textColor="#E5E7EB"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Save Profile Button -->
            <Button
                android:id="@+id/btnSaveProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#DC2626"
                android:text="💾 Lưu Hồ Sơ &amp; Cài Đặt"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
