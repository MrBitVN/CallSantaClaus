<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0708"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="36dp"
        android:paddingBottom="40dp">

        <!-- Top App Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎅 SantaCall Magic"
                    android:textColor="#FEF3C7"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNorthPoleStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="North Pole: -18°C • Light Snow ❄️"
                    android:textColor="#6EE7B7"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Parent Gate Button -->
            <Button
                android:id="@+id/btnParentSettings"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="#271919"
                android:text="🔒 Parents"
                android:textColor="#FBBF24"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Scheduled Call Indicator (Hidden by default) -->
        <LinearLayout
            android:id="@+id/layoutScheduledBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#DC2626"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="10dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvScheduledCountdown"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎅 Santa is preparing to call... Rings in 10s!"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnCancelScheduled"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:backgroundTint="#000000"
                android:text="Cancel"
                android:textColor="#FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Child Greeting Hero Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#1C1414"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:src="@drawable/splash"
                    android:scaleType="centerCrop" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvHeroGreeting"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Hello Little Star! 🎅"
                        android:textColor="#FEF3C7"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvHeroSub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Santa is eager to speak with you from the North Pole!"
                        android:textColor="#D1D5DB"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/tvNiceListBadge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="#064E3B"
                android:padding="8dp"
                android:text="⭐ CHILD STATUS: OFFICIAL NICE LIST"
                android:textColor="#6EE7B7"
                android:textSize="11sp"
                android:textStyle="bold"
                android:gravity="center" />
        </LinearLayout>

        <!-- Section Title: Quick Actions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="CONNECT WITH SANTA CLAUS"
            android:textColor="#FBBF24"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- 4 Primary Action Buttons Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginBottom="10dp">

            <!-- Video Call -->
            <Button
                android:id="@+id/btnMainVideoCall"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#DC2626"
                android:text="📹 Video Call\nFaceTime HD"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- Voice Call -->
            <Button
                android:id="@+id/btnMainVoiceCall"
                android:layout_width="0dp"
                android:layout_height="64dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#059669"
                android:text="📞 Voice Call\n4-Turn Interactive"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- Voicemail -->
            <Button
                android:id="@+id/btnMainVoicemail"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#271919"
                android:text="🎙️ Voicemail"
                android:textColor="#FEF3C7"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Chat -->
            <Button
                android:id="@+id/btnMainChat"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#271919"
                android:text="💬 Chat with Santa"
                android:textColor="#FEF3C7"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Video Messages Button -->
        <Button
            android:id="@+id/btnMainVideoMessages"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#271919"
            android:text="🎬 Video Messages from Santa (Birthday, Nice List...)"
            android:textColor="#FBBF24"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Scenarios Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="SPECIAL CALL SCENARIOS"
            android:textColor="#FBBF24"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <!-- Scenario Item 1: Birthday -->
        <LinearLayout
            android:id="@+id/itemScenarioBirthday"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#1E1919"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🎂"
                android:textSize="24sp"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Happy Birthday from North Pole"
                    android:textColor="#FEF3C7"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Santa opens his calendar with birthday wishes"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnTriggerBirthday"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#B45309"
                android:text="Call Now"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Scenario Item 2: Discipline -->
        <LinearLayout
            android:id="@+id/itemScenarioDiscipline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="#1E1919"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌟"
                android:textSize="24sp"
                android:layout_marginEnd="12dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Good Behavior &amp; Listening"
                    android:textColor="#FEF3C7"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Santa encourages good habits to earn gifts"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btnTriggerDiscipline"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:backgroundTint="#B45309"
                android:text="Call Now"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Scheduler Trigger Section for Parents -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="SCHEDULE A SURPRISE CALL"
            android:textColor="#FBBF24"
            android:textSize="12sp"
            android:textStyle="bold"
            android:letterSpacing="0.05" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/btnSchedule10s"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#374151"
                android:text="In 10 sec"
                android:textColor="#E5E7EB"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSchedule30s"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#374151"
                android:text="In 30 sec"
                android:textColor="#E5E7EB"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnSchedule1m"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#374151"
                android:text="In 1 min"
                android:textColor="#E5E7EB"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

</ScrollView>
