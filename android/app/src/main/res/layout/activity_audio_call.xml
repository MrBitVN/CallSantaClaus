<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0708">

    <!-- Festive Background Ambient Overlay -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#150808" />

    <!-- Top Header -->
    <LinearLayout
        android:id="@+id/layoutTopHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvCallTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00"
            android:textColor="#E0D6D0"
            android:textSize="14sp"
            android:textStyle="bold"
            android:fontFamily="monospace" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Status Badge -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1B3320"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:background="#4ADE80" />

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="Bắc Cực • HD Audio"
                android:textColor="#86EFAC"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Center Content: Avatar & Status -->
    <LinearLayout
        android:id="@+id/layoutCenter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/layoutTopHeader"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp">

        <!-- Santa Avatar Container -->
        <RelativeLayout
            android:layout_width="140dp"
            android:layout_height="140dp">

            <ImageView
                android:id="@+id/ivSantaAvatar"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:src="@drawable/splash"
                android:scaleType="centerCrop" />

            <!-- Listening / Speaking Badge -->
            <TextView
                android:id="@+id/tvStageBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_centerHorizontal="true"
                android:background="#F59E0B"
                android:textColor="#1F1500"
                android:text="🎅 Santa đang nói..."
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp" />
        </RelativeLayout>

        <TextView
            android:id="@+id/tvCallerName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ông Già Noel"
            android:textColor="#FEF3C7"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvChildInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Cuộc gọi dành cho Bé Yêu (5 tuổi)"
            android:textColor="#FDE68A"
            android:textSize="13sp" />

        <!-- Subtitles Card -->
        <LinearLayout
            android:id="@+id/layoutSubtitles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="#1E1919"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tvSubtitleHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Santa Claus:"
                android:textColor="#FBBF24"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSubtitleText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="A lô! A lô! Có phải bé đó không? Ta là Ông già Noel đây! Cháu có nghe rõ Ta nói không nào?"
                android:textColor="#F3F4F6"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Interactive Child Response Area (Calling & Response / Thưa gửi) -->
    <LinearLayout
        android:id="@+id/layoutChildInteraction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/layoutBottomControls"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingBottom="16dp">

        <TextView
            android:id="@+id/tvPromptHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Bé thưa chuyện với Ông già Noel:"
            android:textColor="#6EE7B7"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:id="@+id/layoutResponseButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <Button
                android:id="@+id/btnOption1"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:backgroundTint="#059669"
                android:text="⭐ Dạ con chào Ông!"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOption2"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:backgroundTint="#D97706"
                android:text="🎅 Dạ con nghe rõ ạ!"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Bottom Controls: Mute, Replay, Subtitles, End Call -->
    <LinearLayout
        android:id="@+id/layoutBottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:layout_marginBottom="24dp">

            <!-- Mute Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginEnd="32dp">

                <ImageButton
                    android:id="@+id/btnMute"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="#262222"
                    android:src="@android:drawable/stat_sys_speakerphone"
                    android:tint="#FFFFFF"
                    android:contentDescription="Mute" />

                <TextView
                    android:id="@+id/tvMuteLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Tắt Mic"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Replay Button -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginEnd="32dp">

                <ImageButton
                    android:id="@+id/btnReplay"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="#262222"
                    android:src="@android:drawable/ic_menu_rotate"
                    android:tint="#F59E0B"
                    android:contentDescription="Restart" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Gọi lại"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Subtitle Toggle -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageButton
                    android:id="@+id/btnToggleSubtitles"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="#262222"
                    android:src="@android:drawable/ic_menu_help"
                    android:tint="#FFFFFF"
                    android:contentDescription="Subtitles" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Phụ đề"
                    android:textColor="#9CA3AF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Red End Call Button -->
        <ImageButton
            android:id="@+id/btnEndCall"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="#DC2626"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:tint="#FFFFFF"
            android:contentDescription="End Call" />

    </LinearLayout>

</RelativeLayout>
