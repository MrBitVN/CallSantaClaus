<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0708"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1C1414"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/btnBackFromVideoMessages"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📹 Video Lời Nhắn Từ Santa"
            android:textColor="#FEF3C7"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: Birthday -->
            <LinearLayout
                android:id="@+id/cardVideoBirthday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1C1414"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎂 Chúc Mừng Sinh Nhật Bé Yêu"
                    android:textColor="#FEF3C7"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Santa mở lịch Bắc Cực và gửi lời chúc mừng sinh nhật kỳ diệu dành riêng cho bé"
                    android:textColor="#D1D5DB"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnPlayVideoBirthday"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#DC2626"
                    android:text="Xem Video Sinh Nhật 🎬"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 2: Nice Book -->
            <LinearLayout
                android:id="@+id/cardVideoNiceBook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1C1414"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📖 Cuốn Sổ Bé Ngoan Của Santa"
                    android:textColor="#FEF3C7"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Santa lật từng trang sách vàng tìm tên bé trong danh sách được nhận quà Noel"
                    android:textColor="#D1D5DB"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnPlayVideoNiceBook"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#DC2626"
                    android:text="Xem Video Sổ Bé Ngoan 🎬"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 3: Sleigh Flight -->
            <LinearLayout
                android:id="@+id/cardVideoSleigh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1C1414"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🦌 Chuyến Bay Cỗ Xe Tuần Lộc"
                    android:textColor="#FEF3C7"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Theo chân Santa và tuần lộc Rudolph bay qua những đám mây tuyết trắng mang quà tới"
                    android:textColor="#D1D5DB"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnPlayVideoSleigh"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#DC2626"
                    android:text="Xem Video Cỗ Xe Bay 🎬"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 4: Letter to Santa -->
            <LinearLayout
                android:id="@+id/cardVideoLetter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1C1414"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✉️ Santa Đọc Thư Giáng Sinh"
                    android:textColor="#FEF3C7"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Santa ngồi bên lò sưởi ấm áp đọc từng dòng thư và điều ước của các em nhỏ"
                    android:textColor="#D1D5DB"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnPlayVideoLetter"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#DC2626"
                    android:text="Xem Video Đọc Thư 🎬"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
