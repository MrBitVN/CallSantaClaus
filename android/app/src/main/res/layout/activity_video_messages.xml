<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0708"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="#1C1414"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <Button
            android:id="@+id/btnBackFromVideoMessages"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="📹 Video Messages from Santa"
            android:textColor="#FEF3C7"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: Birthday -->
            <LinearLayout
                android:id="@+id/cardVideoBirthday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1C1414"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎂 Santa's Happy Birthday Blessing"
                    android:textColor="#FEF3C7"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Santa opens his North Pole calendar and sends a magical birthday wish"
                    android:textColor="#D1D5DB"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnPlayVideoBirthday"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#DC2626"
                    android:text="Watch Birthday Video 🎬"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 2: Nice Book -->
            <LinearLayout
                android:id="@+id/cardVideoNiceBook"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1C1414"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📖 Santa's Golden Nice List Book"
                    android:textColor="#FEF3C7"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Santa flips through his golden book searching for your name on the Nice List"
                    android:textColor="#D1D5DB"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnPlayVideoNiceBook"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#DC2626"
                    android:text="Watch Nice List Video 🎬"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 3: Sleigh Flight -->
            <LinearLayout
                android:id="@+id/cardVideoSleigh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1C1414"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🦌 Magical Sleigh Flight Across Stars"
                    android:textColor="#FEF3C7"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Fly alongside Santa and Rudolph through snowy clouds delivering gifts"
                    android:textColor="#D1D5DB"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnPlayVideoSleigh"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#DC2626"
                    android:text="Watch Sleigh Flight Video 🎬"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card 4: Letter to Santa -->
            <LinearLayout
                android:id="@+id/cardVideoLetter"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#1C1414"
                android:orientation="vertical"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✉️ Santa Reading Christmas Letters"
                    android:textColor="#FEF3C7"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Santa sits by the cozy fireplace reading letters and wishes from children"
                    android:textColor="#D1D5DB"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btnPlayVideoLetter"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="10dp"
                    android:backgroundTint="#DC2626"
                    android:text="Watch Reading Letter Video 🎬"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
