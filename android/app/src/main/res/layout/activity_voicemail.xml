<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0708"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="36dp"
    android:paddingBottom="36dp">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnBackFromVoicemail"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:backgroundTint="#262222"
            android:text="← Trang chủ"
            android:textColor="#E5E7EB"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Hộp Thư Thoại Bắc Cực"
            android:textColor="#FEF3C7"
            android:textSize="17sp"
            android:textStyle="bold"
            android:gravity="center" />

        <View
            android:layout_width="50dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <!-- Dial Display -->
    <TextView
        android:id="@+id/tvDialNumber"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center"
        android:text="1800-SANTA"
        android:textColor="#FDE68A"
        android:textSize="26sp"
        android:textStyle="bold"
        android:fontFamily="monospace"
        android:background="#1E1919"
        android:layout_marginBottom="16dp" />

    <!-- 3x4 DTMF Dial Pad Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="3"
        android:rowCount="4"
        android:alignmentMode="alignMargins"
        android:columnOrderPreserved="false"
        android:useDefaultMargins="true"
        android:layout_gravity="center_horizontal">

        <Button android:id="@+id/btnKey1" android:layout_width="90dp" android:layout_height="64dp" android:text="1" android:textColor="#FFFFFF" android:textSize="20sp" android:backgroundTint="#262222" />
        <Button android:id="@+id/btnKey2" android:layout_width="90dp" android:layout_height="64dp" android:text="2\nABC" android:textColor="#FFFFFF" android:textSize="14sp" android:backgroundTint="#262222" />
        <Button android:id="@+id/btnKey3" android:layout_width="90dp" android:layout_height="64dp" android:text="3\nDEF" android:textColor="#FFFFFF" android:textSize="14sp" android:backgroundTint="#262222" />

        <Button android:id="@+id/btnKey4" android:layout_width="90dp" android:layout_height="64dp" android:text="4\nGHI" android:textColor="#FFFFFF" android:textSize="14sp" android:backgroundTint="#262222" />
        <Button android:id="@+id/btnKey5" android:layout_width="90dp" android:layout_height="64dp" android:text="5\nJKL" android:textColor="#FFFFFF" android:textSize="14sp" android:backgroundTint="#262222" />
        <Button android:id="@+id/btnKey6" android:layout_width="90dp" android:layout_height="64dp" android:text="6\nMNO" android:textColor="#FFFFFF" android:textSize="14sp" android:backgroundTint="#262222" />

        <Button android:id="@+id/btnKey7" android:layout_width="90dp" android:layout_height="64dp" android:text="7\nPQRS" android:textColor="#FFFFFF" android:textSize="14sp" android:backgroundTint="#262222" />
        <Button android:id="@+id/btnKey8" android:layout_width="90dp" android:layout_height="64dp" android:text="8\nTUV" android:textColor="#FFFFFF" android:textSize="14sp" android:backgroundTint="#262222" />
        <Button android:id="@+id/btnKey9" android:layout_width="90dp" android:layout_height="64dp" android:text="9\nWXYZ" android:textColor="#FFFFFF" android:textSize="14sp" android:backgroundTint="#262222" />

        <Button android:id="@+id/btnKeyStar" android:layout_width="90dp" android:layout_height="64dp" android:text="*" android:textColor="#FBBF24" android:textSize="22sp" android:backgroundTint="#262222" />
        <Button android:id="@+id/btnKey0" android:layout_width="90dp" android:layout_height="64dp" android:text="0\n+" android:textColor="#FFFFFF" android:textSize="14sp" android:backgroundTint="#262222" />
        <Button android:id="@+id/btnKeyHash" android:layout_width="90dp" android:layout_height="64dp" android:text="#" android:textColor="#FBBF24" android:textSize="20sp" android:backgroundTint="#262222" />
    </GridLayout>

    <!-- Record Wishlist Button -->
    <Button
        android:id="@+id/btnRecordWish"
        android:layout_width="match_parent"
        android:layout_height="54dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="#DC2626"
        android:text="🎙️ Ghi Âm Điều Ước Gửi Santa"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWishStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Bấm các phím số hoặc nhấn ghi âm để gửi điều ước thẳng tới xưởng quà Santa!"
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:gravity="center" />

</LinearLayout>
